  "item": [
    {
      "name": "1. Farm Management & Budgets",
      "item": [
        {
          "name": "Create Farm & Set Budgets",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"مزرعة النيل النموذجية\",\n  \"owner_name\": \"م. يوسف عثمان\",\n  \"zone\": \"Delta\",\n  \"total_area_feddans\": 160.0,\n  \"water_budget_m3\": 500000.0,\n  \"labor_budget_hours\": 3000.0,\n  \"fertilizer_budget_kg\": 20000.0,\n  \"labor_rate_egp_per_hour\": 20.0,\n  \"fertilizer_rate_egp_per_kg\": 1.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/farms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "farms"]
            },
            "description": "Stores farm entity and resource budgets into the `farms` table."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": \"9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d\",\n  \"name\": \"مزرعة النيل النموذجية\",\n  \"zone\": \"Delta\",\n  \"total_area_feddans\": 160.0,\n  \"water_budget_m3\": 500000.0,\n  \"labor_budget_hours\": 3000.0,\n  \"fertilizer_budget_kg\": 20000.0,\n  \"created_at\": \"2026-09-02T19:00:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Get Farm Details & Fields",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/farms/{{farmId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "farms", "{{farmId}}"]
            },
            "description": "Retrieves farm budgets and associated field parcels."
          }
        }
      ]
    },
    {
      "name": "2. Fields & Soil Measurements",
      "item": [
        {
          "name": "Add Field Parcel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farm_id\": \"{{farmId}}\",\n  \"name_en\": \"North Basin\",\n  \"name_ar\": \"حوض الشمالي\",\n  \"area_feddans\": 100.0,\n  \"soil_ph\": 6.8,\n  \"soil_ec_ds_m\": 1.2,\n  \"soil_texture\": \"Loam\",\n  \"organic_matter_pct\": 2.5,\n  \"previous_crop_name\": \"Wheat\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/farms/{{farmId}}/fields",
              "host": ["{{baseUrl}}"],
              "path": ["api", "farms", "{{farmId}}", "fields"]
            },
            "description": "Adds a field parcel with soil parameters and previous crop rotation history."
          }
        },
        {
          "name": "List Farm Fields",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/farms/{{farmId}}/fields",
              "host": ["{{baseUrl}}"],
              "path": ["api", "farms", "{{farmId}}", "fields"]
            }
          }
        }
      ]
    },
    {
